---
type Paper = {
  id: string;
  title: string;
  title_cn?: string;
  authors?: string[];
  abstract?: string;
  abstract_cn?: string;
  url: string;
  public_date?: string;
  translation_status?: {
    title?: string;
    abstract?: string;
  };
};

interface Props {
  paper: Paper;
  index: number;
}

const { paper, index } = Astro.props;
const authors = Array.isArray(paper.authors) && paper.authors.length ? paper.authors.join(", ") : "Unknown authors";
const status = paper.translation_status || {};
const hasTitleCn = status.title === "success" && paper.title_cn;
const hasAbstractCn = status.abstract === "success" && paper.abstract_cn;
const abstractEn = paper.abstract || "No abstract available.";
const pdf = `https://www.nber.org/system/files/working_papers/${paper.id}/${paper.id}.pdf`;
---

<article class="entry" id={paper.id} data-entry>
  <div class="entry__side">
    <span class="entry__num">{String(index).padStart(2, "0")}</span>
  </div>
  <div>
    <p class="entry__meta">
      <span class="id">{paper.id}</span>
      {paper.public_date && <span>{paper.public_date}</span>}
    </p>
    {hasTitleCn ? (
      <>
        <h2 class="entry__title">{paper.title_cn}</h2>
        <a class="entry__en" href={paper.url} target="_blank" rel="noreferrer noopener">{paper.title}</a>
      </>
    ) : (
      <h2 class="entry__title"><a class="entry__en entry__en--lead" href={paper.url} target="_blank" rel="noreferrer noopener">{paper.title}</a></h2>
    )}
    <p class="entry__authors">{authors}</p>

    {hasAbstractCn ? (
      <>
        <p class="entry__abs">{paper.abstract_cn}</p>
        <details data-en>
          <summary>English abstract</summary>
          <p class="entry__abs entry__abs--en" lang="en">{abstractEn}</p>
        </details>
      </>
    ) : (
      <>
        <p class="entry__abs entry__abs--en" lang="en">{abstractEn}</p>
        <p class="entry__note">中文摘要暂未完成翻译</p>
      </>
    )}

    <div class="entry__links">
      <a href={paper.url} target="_blank" rel="noreferrer noopener">NBER 原文页 ↗</a>
      <a href={pdf} target="_blank" rel="noreferrer noopener">PDF ↗</a>
    </div>
  </div>
</article>
