---
import Layout from "../components/Layout.astro";
import IssueView from "../components/IssueView.astro";
import papers from "../data/papers.json";
import archive from "../data/archive.json";
import meta from "../data/update-meta.json";

const issues = (archive as any[])
  .map((entry) => ({ date: entry.batch_date as string, count: (entry.papers || []).length }))
  .sort((a, b) => b.date.localeCompare(a.date));
---

<Layout title="NBER Weekly · 本周 NBER 工作论文">
  <IssueView papers={papers} batchDate={meta.batch_date || ""} lastUpdated={meta.last_updated} issues={issues} latest />
</Layout>
